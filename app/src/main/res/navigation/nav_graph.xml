<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/passwordVaultFragment">

    <fragment
        android:id="@+id/passwordVaultFragment"
        android:name="com.venkatbhoogarbh.krypta.ui.fragments.PasswordVaultFragment"
        android:label="Passwords"
        tools:layout="@layout/fragment_password_vault">
        <action
            android:id="@+id/action_vault_to_details"
            app:destination="@id/passwordDetailsFragment" />
        <action
            android:id="@+id/action_vault_to_add"
            app:destination="@id/addPasswordFragment" />
    </fragment>

    <fragment
        android:id="@+id/documentVaultFragment"
        android:name="com.venkatbhoogarbh.krypta.ui.fragments.DocumentVaultFragment"
        android:label="Documents"
        tools:layout="@layout/fragment_document_vault">
        <action
            android:id="@+id/action_document_vault_to_details"
            app:destination="@id/documentDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/documentDetailsFragment"
        android:name="com.venkatbhoogarbh.krypta.ui.fragments.DocumentDetailsFragment"
        android:label="Document Details"
        tools:layout="@layout/fragment_document_details" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.venkatbhoogarbh.krypta.ui.fragments.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/passwordDetailsFragment"
        android:name="com.venkatbhoogarbh.krypta.ui.fragments.PasswordDetailsFragment"
        android:label="Password Details"
        tools:layout="@layout/fragment_password_details">
        <action
            android:id="@+id/action_details_to_edit"
            app:destination="@id/addPasswordFragment" />
    </fragment>

    <fragment
        android:id="@+id/addPasswordFragment"
        android:name="com.venkatbhoogarbh.krypta.ui.fragments.AddPasswordFragment"
        android:label="Add Account"
        tools:layout="@layout/fragment_add_password" />

</navigation>